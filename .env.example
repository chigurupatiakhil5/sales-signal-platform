# Neon PostgreSQL connection string.
# Neon dashboard -> your project -> Connect -> copy the "psql" connection string.
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/sales_signal?sslmode=require

# HubSpot Private App access token.
# HubSpot -> Settings -> Integrations -> Private Apps -> Create a private app.
# Required scopes: crm.objects.deals.read, crm.objects.deals.write,
#                   crm.objects.notes.read, crm.objects.notes.write
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Groq API key (free tier). console.groq.com -> API Keys.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used to classify deals. If you get a "model decommissioned" error,
# check console.groq.com/docs/models for the current model ID and update
# this - no code change needed.
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
